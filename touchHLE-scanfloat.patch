+/// Shared implementation of `scanFloat:` and `scanDouble:`. On success,
+/// advances the scan location past the number and returns its value.
+fn scan_float(env: &mut Environment, scanner: id) -> Option<f64> {
+    skip_characters(env, scanner);
+
+    let &NSScannerHostObject { string, len, pos, .. } = env.objc.borrow(scanner);
+    if pos >= len {
+        return None;
+    }
+    let left: id = msg![env; string substringFromIndex:pos];
+    let st = to_rust_string(env, left);
+    let (cutoff, value) = parse_float_prefix(&st)?;
+    log_dbg!("scanFloat/Double: from '{}' -> {}", st, value);
+
+    // The number is ASCII only, so its byte length is its UTF-16 length.
+    env.objc.borrow_mut::<NSScannerHostObject>(scanner).pos = pos + cutoff as NSUInteger;
+    Some(value)
+}
