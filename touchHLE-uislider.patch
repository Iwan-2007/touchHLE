 //! `UISlider`.
 
 use crate::frameworks::core_graphics::CGRect;
+use crate::frameworks::foundation::NSUInteger;
+use crate::mem::GuestUSize;
 use crate::objc::{id, msg_super, objc_classes, todo_objc_setter, ClassExports};
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+/// (value, minimumValue, maximumValue)
+type SliderValues = (f32, f32, f32);
+const DEFAULT_VALUES: SliderValues = (0.0, 0.0, 1.0);
+
+thread_local! {
+    /// Values of each slider, keyed by object address.
+    /// TODO: move this into a proper host object once the slider is drawn.
+    static SLIDER_VALUES: RefCell<HashMap<GuestUSize, SliderValues>> = RefCell::new(HashMap::new());
+}
+
+fn get_values(this: id) -> SliderValues {
+    SLIDER_VALUES.with(|m| m.borrow().get(&this.to_bits()).copied().unwrap_or(DEFAULT_VALUES))
+}
+fn set_values(this: id, f: impl FnOnce(&mut SliderValues)) {
+    SLIDER_VALUES.with(|m| {
+        let mut m = m.borrow_mut();
+        let values = m.entry(this.to_bits()).or_insert(DEFAULT_VALUES);
+        f(values);
+        // Keep the value inside the range, like UIKit does.
+        values.0 = values.0.max(values.1).min(values.2);
+    });
+}
 
