 pub mod app_picker;
+
+/// Temporary diagnostics (touchHLE-zzzzz-perf.patch): find what makes some
+/// frames take very long. Measures the time spent in each host function
+/// (excluding nested calls) between two presented frames, and logs the
+/// biggest ones when a frame is slow.
+pub mod perf_debug {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+
+    #[derive(Default)]
+    struct State {
+        /// (start, time spent in nested calls)
+        stack: Vec<(Instant, Duration)>,
+        per_name: HashMap<String, (Duration, u32)>,
+        last_present: Option<Instant>,
+    }
+    static STATE: Mutex<Option<State>> = Mutex::new(None);
+
+    pub fn begin() {
+        if let Ok(mut guard) = STATE.lock() {
+            let state = guard.get_or_insert_with(Default::default);
+            state.stack.push((Instant::now(), Duration::ZERO));
+        }
+    }
+
+    pub fn end(name: &str) {
+        if let Ok(mut guard) = STATE.lock() {
+            let state = guard.get_or_insert_with(Default::default);
+            let Some((start, nested)) = state.stack.pop() else {
+                return;
+            };
+            let elapsed = start.elapsed();
+            let exclusive = elapsed.saturating_sub(nested);
+            if let Some(parent) = state.stack.last_mut() {
+                parent.1 += elapsed;
+            }
+            if let Some(entry) = state.per_name.get_mut(name) {
+                entry.0 += exclusive;
+                entry.1 += 1;
+            } else {
+                state.per_name.insert(name.to_string(), (exclusive, 1));
+            }
+        }
+    }
+
+    pub fn frame_presented() {
+        let Ok(mut guard) = STATE.lock() else {
+            return;
+        };
+        let state = guard.get_or_insert_with(Default::default);
+        let now = Instant::now();
+        if let Some(last) = state.last_present {
+            let frame = now - last;
+            if frame > Duration::from_millis(150) {
+                let mut entries: Vec<_> = state.per_name.iter().collect();
+                entries.sort_by(|a, b| b.1 .0.cmp(&a.1 .0));
+                let attributed: Duration = state.per_name.values().map(|v| v.0).sum();
+                let mut msg = format!(
+                    "PERF slow frame: {} ms ({} ms not in any host function)",
+                    frame.as_millis(),
+                    frame.saturating_sub(attributed).as_millis()
+                );
+                for (name, (time, count)) in entries.iter().take(8) {
+                    msg.push_str(&format!(
+                        "\n    {:>6.1} ms  {} ({} calls)",
+                        time.as_secs_f64() * 1000.0,
+                        name,
+                        count
+                    ));
+                }
+                log!("{}", msg);
+            }
+        }
+        state.per_name.clear();
+        state.last_present = Some(now);
+    }
+}
 mod mutex;
 mod nullable_box;
 
