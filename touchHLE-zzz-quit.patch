 /// Tell the app it's about to quit and then exit.
+/// Set once the app has been told to terminate, see [exit].
+pub static EXITING: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
 pub(super) fn exit(env: &mut Environment) {
+    EXITING.store(true, std::sync::atomic::Ordering::Relaxed);
     let ui_application: id = msg_class![env; UIApplication sharedApplication];
 
     let center: id = msg_class![env; NSNotificationCenter defaultCenter];
