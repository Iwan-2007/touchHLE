@@ -278,6 +278,24 @@ fn pthread_cancel(_env: &mut Environment, thread: pthread_t) -> i32 {
     0
 }
 
+fn pthread_exit(env: &mut Environment, value_ptr: MutVoidPtr) {
+    if env.current_thread == 0 {
+        echo!("App called pthread_exit() on the main thread, exiting.");
+        std::process::exit(0);
+    }
+    log_dbg!("pthread_exit({:?}) on thread {}", value_ptr, env.current_thread);
+    // Return straight to the host code that called this thread's start
+    // routine, abandoning the guest stack: the thread then ends as if the
+    // start routine had returned `value_ptr`. (The return-to-host routine is
+    // set both as the next instruction and as the return address, so it is
+    // reached however this function call returns.)
+    let return_to_host = env.dyld.return_to_host_routine();
+    let regs = env.cpu.regs_mut();
+    regs[0] = value_ptr.to_bits();
+    regs[crate::cpu::Cpu::LR] = return_to_host.addr_with_thumb_bit();
+    env.cpu.branch(return_to_host);
+}
