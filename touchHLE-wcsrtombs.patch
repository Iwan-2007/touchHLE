+/// Wide string to multibyte string, restartable version. Like `wcstombs`,
+/// this assumes the "C" locale: every wide character must fit in one byte.
+fn wcsrtombs(
+    env: &mut Environment,
+    dst: MutPtr<u8>,
+    src: MutPtr<ConstPtr<wchar_t>>,
+    len: GuestUSize,
+    _ps: MutVoidPtr,
+) -> GuestUSize {
+    const EILSEQ: i32 = 92; // Darwin value
+    set_errno(env, 0);
+    let s = env.mem.read(src);
+    let mut i: GuestUSize = 0;
+    loop {
+        if !dst.is_null() && i >= len {
+            env.mem.write(src, s + i);
+            return i;
+        }
+        let wc = env.mem.read(s + i);
+        if wc == 0 {
+            if !dst.is_null() {
+                env.mem.write(dst + i, b'\0');
+                env.mem.write(src, Ptr::null());
+            }
+            return i;
+        }
+        if !(0..=255).contains(&wc) {
+            set_errno(env, EILSEQ);
+            if !dst.is_null() {
+                env.mem.write(src, s + i);
+            }
+            return GuestUSize::MAX;
+        }
+        if !dst.is_null() {
+            env.mem.write(dst + i, wc as u8);
+        }
+        i += 1;
+    }
+}
