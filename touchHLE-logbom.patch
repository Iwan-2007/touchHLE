 pub fn main<T: Iterator<Item = String>>(mut args: T) -> Result<(), String> {
+    // When the output is redirected to a file, start it with a UTF-8 byte
+    // order mark so that text editors read it correctly. (Not done in a
+    // terminal, where it would just be an unwanted character.)
+    {
+        use std::io::{IsTerminal, Write};
+        let mut stderr = std::io::stderr();
+        if !stderr.is_terminal() {
+            let _ = stderr.write_all(log::UTF8_BOM);
+        }
+    }
