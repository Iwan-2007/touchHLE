+// --- Temporary diagnostics (touchHLE-zzz-debug.patch) ---
+
+/// Log the whole view hierarchy: class, frame, visibility and label texts.
+fn debug_dump_view_tree(env: &mut Environment) {
+    log!("===== VIEW TREE =====");
+    let windows = env.framework_state.uikit.ui_view.ui_window.windows.clone();
+    for window in windows {
+        debug_dump_view(env, window, 0);
+    }
+    log!("===== END VIEW TREE =====");
+}
+fn debug_dump_view(env: &mut Environment, view: id, depth: usize) {
+    let class: Class = msg![env; view class];
+    let name = env.objc.get_class_name(class).to_string();
+    let frame: CGRect = msg![env; view frame];
+    let (fx, fy, fw, fh) = (frame.origin.x, frame.origin.y, frame.size.width, frame.size.height);
+    let hidden: bool = msg![env; view isHidden];
+    let alpha: CGFloat = msg![env; view alpha];
+    let layer: id = msg![env; view layer];
+    let layer_class: Class = msg![env; layer class];
+    let layer_name = env.objc.get_class_name(layer_class).to_string();
+    let opaque: bool = msg![env; layer isOpaque];
+    let label_class: Class = msg_class![env; UILabel class];
+    let is_label: bool = msg![env; view isKindOfClass:label_class];
+    let text = if is_label {
+        let text: id = msg![env; view text];
+        if text != nil {
+            format!(" text={:?}", to_rust_string(env, text).replace('\0', ""))
+        } else {
+            String::new()
+        }
+    } else {
+        String::new()
+    };
+    log!(
+        "{}{} {:?} frame=({:.0},{:.0} {:.0}x{:.0}) hidden={} alpha={:.2} layer={} opaque={}{}",
+        "  ".repeat(depth),
+        name,
+        view,
+        fx,
+        fy,
+        fw,
+        fh,
+        hidden,
+        alpha,
+        layer_name,
+        opaque,
+        text
+    );
+    let subviews: id = msg![env; view subviews];
+    let count: NSUInteger = msg![env; subviews count];
+    for i in 0..count {
+        let subview: id = msg![env; subviews objectAtIndex:i];
+        debug_dump_view(env, subview, depth + 1);
+    }
+}
