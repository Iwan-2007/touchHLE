+/// iOS draws nothing for U+0000, and some apps leave NUL characters in their
+/// strings (e.g. 4-byte `wchar_t` text decoded as UTF-16). Our fonts would
+/// draw a "missing glyph" box for each one, so drop them before measuring or
+/// drawing.
+fn strip_nul(text: &str) -> Cow<'_, str> {
+    if text.contains('\0') {
+        Cow::Owned(text.replace('\0', ""))
+    } else {
+        Cow::Borrowed(text)
+    }
+}
