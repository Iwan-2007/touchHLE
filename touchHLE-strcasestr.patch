+/// Case-insensitive `strstr` (ASCII only).
+fn strcasestr(env: &mut Environment, string: ConstPtr<u8>, substring: ConstPtr<u8>) -> ConstPtr<u8> {
+    let hay = env.mem.cstr_at(string).to_ascii_lowercase();
+    let needle = env.mem.cstr_at(substring).to_ascii_lowercase();
+    if needle.is_empty() {
+        return string;
+    }
+    match hay.windows(needle.len()).position(|w| w == needle.as_slice()) {
+        Some(pos) => string + pos as GuestUSize,
+        None => Ptr::null(),
+    }
+}
 fn strchr(env: &mut Environment, path: ConstPtr<u8>, c: u8) -> ConstPtr<u8> {
     GenericChar::<u8>::strchr(env, path, c)
 }
