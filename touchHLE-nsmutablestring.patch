+- (NSUInteger)replaceOccurrencesOfString:(id)target // NSString*
+                              withString:(id)replacement // NSString*
+                                 options:(NSStringCompareOptions)options
+                                   range:(NSRange)range {
+    // Count the matches first (the return value), then reuse the immutable
+    // implementation for the actual replacement.
+    let fold = |c: u16| {
+        if options & NSCaseInsensitiveSearch != 0 && (0x41..=0x5A).contains(&c) {
+            c + 0x20
+        } else {
+            c
+        }
+    };
+    let mut hay = Vec::new();
+    for_each_code_unit(env, this, |_, c| hay.push(fold(c)));
+    let mut needle = Vec::new();
+    for_each_code_unit(env, target, |_, c| needle.push(fold(c)));
+    let start = range.location as usize;
+    let end = (start + range.length as usize).min(hay.len());
+    let mut count: NSUInteger = 0;
+    if !needle.is_empty() {
+        let mut i = start;
+        while i + needle.len() <= end {
+            if hay[i..i + needle.len()] == needle[..] {
+                count += 1;
+                i += needle.len();
+            } else {
+                i += 1;
+            }
+        }
+    }
+    if count > 0 {
+        let new: id = msg![env; this stringByReplacingOccurrencesOfString:target
+                                                               withString:replacement
+                                                                  options:options
+                                                                    range:range];
+        () = msg![env; this setString:new];
+    }
+    count
+}
