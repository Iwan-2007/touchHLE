+    export_c_func!(CFArraySortValues(_, _, _, _)),
 ];
diff --git a/src/frameworks/foundation/ns_array.rs b/src/frameworks/foundation/ns_array.rs
index 18f809a..ec52a56 100644
--- a/src/frameworks/foundation/ns_array.rs
+++ b/src/frameworks/foundation/ns_array.rs
@@ -869,3 +869,26 @@ fn encode_with_coder_inner(env: &mut Environment, arr: id, coder: id) {
     let scope = get_value_to_encode_for_current_key(env, coder);
     scope.insert("NS.objects".to_string(), plist::Value::Array(encoded_vals));
 }
+
+/// Used by `CFArraySortValues`: stable in-place sort of `len` elements starting
+/// at `start`, using a comparator that returns <0, 0 or >0. Retain counts are
+/// not touched, so this is safe for both retaining and non-retaining arrays.
+pub(crate) fn sort_range_in_place(
+    env: &mut Environment,
+    array: id,
+    start: usize,
+    len: usize,
+    compare: &mut dyn FnMut(&mut Environment, id, id) -> i32,
+) {
+    // Take the vector out so the comparator can call back into the guest.
+    let mut v = std::mem::take(&mut env.objc.borrow_mut::<ArrayHostObject>(array).array);
+    let end = (start + len).min(v.len());
+    for i in (start + 1)..end {
+        let mut j = i;
+        while j > start && compare(env, v[j - 1], v[j]) > 0 {
+            v.swap(j - 1, j);
+            j -= 1;
+        }
+    }
+    env.objc.borrow_mut::<ArrayHostObject>(array).array = v;
+}
