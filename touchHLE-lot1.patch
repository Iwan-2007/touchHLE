 }
 
+fn CFArrayCreateMutableCopy(
+    env: &mut Environment,
+    allocator: CFAllocatorRef,
+    capacity: CFIndex,
+    array: CFArrayRef,
+) -> CFMutableArrayRef {
+    assert!(allocator == kCFAllocatorDefault || env.mem.read(allocator).is_system_default()); // unimplemented
+    assert!(capacity == 0); // TODO: fixed capacity support
+
+    let new: id = msg_class![env; _touchHLE_NSMutableArray_non_retaining new];
+    let count: NSUInteger = msg![env; array count];
+    for i in 0..count {
+        let value: id = msg![env; array objectAtIndex:i];
+        () = msg![env; new addObject:value];
+    }
+    new
+}
+
+fn CFArrayRemoveAllValues(env: &mut Environment, array: CFMutableArrayRef) {
+    // Removing one by one (from the end) lets each array class apply its own
+    // retain/release rules.
+    let count: NSUInteger = msg![env; array count];
+    for i in (0..count).rev() {
+        () = msg![env; array removeObjectAtIndex:i];
+    }
+}
+
+fn CFArraySortValues(
+    env: &mut Environment,
+    array: CFMutableArrayRef,
+    range: CFRange,
+    comparator: GuestFunction, // CFComparatorFunction
+    context: MutVoidPtr,
+) {
+    let start: usize = range.location.try_into().unwrap();
+    let len: usize = range.length.try_into().unwrap();
+    ns_array::sort_range_in_place(env, array, start, len, &mut |env, a, b| {
+        let a: ConstVoidPtr = a.cast().cast_const();
+        let b: ConstVoidPtr = b.cast().cast_const();
+        let res: CFComparisonResult = comparator.call_from_host(env, (a, b, context));
+        res
+    });
+}
+
