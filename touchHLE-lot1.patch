     res
 }
 
+fn inet_aton(env: &mut Environment, cp: ConstPtr<u8>, inp: MutPtr<in_addr>) -> i32 {
+    // Returns 1 for a valid dotted address, 0 otherwise (no errno).
+    let Some(address) = env
+        .mem
+        .cstr_at_utf8(cp)
+        .ok()
+        .and_then(|s| s.parse::<Ipv4Addr>().ok())
+    else {
+        return 0;
+    };
+    if !inp.is_null() {
+        let addr = in_addr {
+            s_addr: u32::from_le_bytes(address.octets()),
+        };
+        env.mem.write(inp, addr);
+    }
+    1
+}
