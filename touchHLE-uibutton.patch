+/// Places the subviews. touchHLE has no real layout pass, so this is also
+/// called whenever the image or the frame changes.
+fn layout(env: &mut Environment, this: id) {
+    let &UIButtonHostObject {
+        title_label,
+        image_view,
+        background_image_view,
+        ..
+    } = env.objc.borrow(this);
+    let bounds: CGRect = msg![env; this bounds];
+
+    () = msg![env; background_image_view setFrame:bounds];
+    () = msg![env; title_label setFrame:bounds];
+
+    // The image keeps its natural size, centered, and is scaled down
+    // (keeping its aspect ratio) if it doesn't fit in the button.
+    let image: id = msg![env; image_view image];
+    let image_frame = if image == nil {
+        CGRect {
+            origin: CGPoint { x: 0.0, y: 0.0 },
+            size: CGSize { width: 0.0, height: 0.0 },
+        }
+    } else {
+        let size: CGSize = msg![env; image size];
+        let (bw, bh) = (bounds.size.width, bounds.size.height);
+        let mut scale: CGFloat = 1.0;
+        if size.width > bw && size.width > 0.0 {
+            scale = scale.min(bw / size.width);
+        }
+        if size.height > bh && size.height > 0.0 {
+            scale = scale.min(bh / size.height);
+        }
+        let (w, h) = (size.width * scale, size.height * scale);
+        CGRect {
+            origin: CGPoint {
+                x: bounds.origin.x + (bw - w) / 2.0,
+                y: bounds.origin.y + (bh - h) / 2.0,
+            },
+            size: CGSize { width: w, height: h },
+        }
+    };
+    () = msg![env; image_view setFrame:image_frame];
+}
