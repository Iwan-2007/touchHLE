-// No cell reuse: apps then create a new cell, which is always correct.
-- (id)dequeueReusableCellWithIdentifier:(id)_identifier {
+- (id)dequeueReusableCellWithIdentifier:(id)identifier { // NSString*
+    if identifier == nil {
+        return nil;
+    }
+    let pool = env.objc.borrow::<UITableViewHostObject>(this).reuse_pool.clone();
+    for (idx, cell) in pool.into_iter().enumerate() {
+        let cell_identifier: id = msg![env; cell reuseIdentifier];
+        if cell_identifier == nil {
+            continue;
+        }
+        let matches: bool = msg![env; cell_identifier isEqualToString:identifier];
+        if matches {
+            env.objc
+                .borrow_mut::<UITableViewHostObject>(this)
+                .reuse_pool
+                .remove(idx);
+            // Hand our reference over to the caller.
+            return crate::objc::autorelease(env, cell);
+        }
+    }
     nil
 }
 
