+/// Cheat for Zombie Attack! Second Wave XL 2.2.1: adds `amount` to the money
+/// of the game in progress.
+///
+/// The game object is found from the app's global pointer (at 0x15d244 in
+/// this version of the binary, read by the function at 0x2890), then
+/// `+0x168`, then `+0x210` (or `+0x20c` in cooperative mode). The money is at
+/// `+8` in that object (the save file loader writes it there).
+fn cheat_add_money(env: &mut Environment, amount: i32) {
+    use crate::mem::{ConstPtr, MutPtr};
+    let read = |env: &Environment, addr: u32| -> u32 {
+        env.mem.read(ConstPtr::<u32>::from_bits(addr))
+    };
+    // Only for that exact binary: check the code of the global getter.
+    if read(env, 0x2890) != 0xe59f0004 || read(env, 0x2894) != 0xe5900000 {
+        log!("F1 cheat: this isn't Zombie Attack! Second Wave XL 2.2.1, ignoring.");
+        return;
+    }
+    let app = read(env, 0x15d244);
+    if app == 0 {
+        log!("F1 cheat: game not started yet.");
+        return;
+    }
+    let holder = read(env, app + 0x168);
+    if holder == 0 {
+        log!("F1 cheat: no game in progress.");
+        return;
+    }
+    let mut game = read(env, holder + 0x210);
+    if game == 0 {
+        game = read(env, holder + 0x20c);
+    }
+    if game == 0 {
+        log!("F1 cheat: no game in progress.");
+        return;
+    }
+    let money_ptr = MutPtr::<i32>::from_bits(game + 8);
+    let old = env.mem.read(money_ptr);
+    let new = old.saturating_add(amount);
+    env.mem.write(money_ptr, new);
+    log!("F1 cheat: money {} -> {}", old, new);
+}
