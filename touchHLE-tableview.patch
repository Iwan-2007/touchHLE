+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! `UITableView` and `UITableViewCell`.
+//!
+//! This is a simplified implementation: every row's cell is requested up front
+//! by `reloadData` and laid out vertically (no cell reuse), which is fine for
+//! the short lists apps of this era typically display. Scrolling comes from
+//! `UIScrollView`, and tapping a cell selects its row.
+
+use super::UIScrollViewHostObject;
+use crate::frameworks::core_graphics::{CGFloat, CGPoint, CGRect, CGSize};
+use crate::frameworks::foundation::ns_index_path::{index_path_row_section, new_index_path};
+use crate::frameworks::foundation::NSInteger;
+use crate::frameworks::uikit::ui_view::UIViewHostObject;
+use crate::objc::{
+    id, impl_HostObject_with_superclass, msg, msg_class, msg_super, nil, objc_classes, release,
+    retain, Class, ClassExports, NSZonePtr,
+};
+use crate::Environment;
+
+type UITableViewStyle = NSInteger;
+const DEFAULT_ROW_HEIGHT: CGFloat = 44.0;
+/// How far a touch may move and still count as a tap on a cell.
+const TAP_SLOP: CGFloat = 10.0;
+
+pub struct UITableViewHostObject {
+    superclass: UIScrollViewHostObject,
+    style: UITableViewStyle,
+    /// `id<UITableViewDataSource>`, weak reference
+    data_source: id,
+    row_height: CGFloat,
+    section_header_height: CGFloat,
+    /// `UIView*`, strong references
+    table_header_view: id,
+    table_footer_view: id,
+    background_view: id,
+    /// Cells currently laid out, with (section, row). Strong references.
+    cells: Vec<(id, NSInteger, NSInteger)>,
+    /// Section header/footer views currently laid out. Strong references.
+    section_views: Vec<id>,
+    selected: Option<(NSInteger, NSInteger)>,
+    loaded: bool,
+}
+impl_HostObject_with_superclass!(UITableViewHostObject);
+impl Default for UITableViewHostObject {
+    fn default() -> Self {
+        UITableViewHostObject {
+            superclass: Default::default(),
+            style: 0,
+            data_source: nil,
+            row_height: DEFAULT_ROW_HEIGHT,
+            section_header_height: 0.0,
+            table_header_view: nil,
+            table_footer_view: nil,
+            background_view: nil,
+            cells: Vec::new(),
+            section_views: Vec::new(),
+            selected: None,
+            loaded: false,
+        }
+    }
+}
+
+pub struct UITableViewCellHostObject {
+    superclass: UIViewHostObject,
+    /// `UIView*`, strong references
+    content_view: id,
+    text_label: id,
+    background_view: id,
+    selected_background_view: id,
+    /// `NSString*`, strong reference
+    reuse_identifier: id,
+    selected: bool,
+    accessory_type: NSInteger,
+    selection_style: NSInteger,
+    /// Where the current touch began, in window co-ordinates.
+    touch_start: Option<CGPoint>,
+}
+impl_HostObject_with_superclass!(UITableViewCellHostObject);
+impl Default for UITableViewCellHostObject {
+    fn default() -> Self {
+        UITableViewCellHostObject {
+            superclass: Default::default(),
+            content_view: nil,
+            text_label: nil,
+            background_view: nil,
+            selected_background_view: nil,
+            reuse_identifier: nil,
+            selected: false,
+            accessory_type: 0,
+            selection_style: 0,
+            touch_start: None,
+        }
+    }
+}
+
+fn responds(env: &mut Environment, obj: id, sel_name: &str) -> bool {
+    obj != nil && env.objc.object_has_method_named(&env.mem, obj, sel_name)
+}
+
+fn rect(x: CGFloat, y: CGFloat, width: CGFloat, height: CGFloat) -> CGRect {
+    CGRect {
+        origin: CGPoint { x, y },
+        size: CGSize { width, height },
+    }
+}
+
+/// Put `view` at the given frame inside `table`, adding it if needed.
+fn place_view(env: &mut Environment, table: id, view: id, frame: CGRect) {
+    () = msg![env; view setFrame:frame];
+    let superview: id = msg![env; view superview];
+    if superview != table {
+        () = msg![env; table addSubview:view];
+    }
+}
+
+/// Find the table view containing `view`, if any.
+fn enclosing_table_view(env: &mut Environment, view: id) -> id {
+    let table_class: Class = msg_class![env; UITableView class];
+    let mut current: id = msg![env; view superview];
+    while current != nil {
+        let is_table: bool = msg![env; current isKindOfClass:table_class];
+        if is_table {
+            return current;
+        }
+        current = msg![env; current superview];
+    }
+    nil
+}
+
+fn set_cell_selected(env: &mut Environment, cell: id, selected: bool) {
+    () = msg![env; cell setSelected:selected animated:false];
+}
+
+fn cell_for(env: &mut Environment, table: id, section: NSInteger, row: NSInteger) -> id {
+    env.objc
+        .borrow::<UITableViewHostObject>(table)
+        .cells
+        .iter()
+        .find(|&&(_, s, r)| s == section && r == row)
+        .map(|&(cell, _, _)| cell)
+        .unwrap_or(nil)
+}
+
+fn select_row(env: &mut Environment, table: id, section: NSInteger, row: NSInteger) {
+    let previous = env.objc.borrow::<UITableViewHostObject>(table).selected;
+    if let Some((s, r)) = previous {
+        let old_cell = cell_for(env, table, s, r);
+        if old_cell != nil {
+            set_cell_selected(env, old_cell, false);
+        }
+    }
+    env.objc.borrow_mut::<UITableViewHostObject>(table).selected = Some((section, row));
+    let cell = cell_for(env, table, section, row);
+    if cell != nil {
+        set_cell_selected(env, cell, true);
+    }
+}
+
+/// Called when a cell was tapped: select it and tell the delegate.
+fn cell_tapped(env: &mut Environment, table: id, cell: id) {
+    let Some((section, row)) = env
+        .objc
+        .borrow::<UITableViewHostObject>(table)
+        .cells
+        .iter()
+        .find(|&&(c, _, _)| c == cell)
+        .map(|&(_, s, r)| (s, r))
+    else {
+        return;
+    };
+    let delegate: id = msg![env; table delegate];
+    let mut index_path = new_index_path(env, section, row);
+    if responds(env, delegate, "tableView:willSelectRowAtIndexPath:") {
+        index_path = msg![env; delegate tableView:table willSelectRowAtIndexPath:index_path];
+        if index_path == nil {
+            return;
+        }
+    }
+    let (section, row) = index_path_row_section(env, index_path);
+    select_row(env, table, section, row);
+    if responds(env, delegate, "tableView:didSelectRowAtIndexPath:") {
+        () = msg![env; delegate tableView:table didSelectRowAtIndexPath:index_path];
+    }
+}
+
+fn reload_data(env: &mut Environment, this: id) {
+    // Throw away the previous layout.
+    let host = env.objc.borrow_mut::<UITableViewHostObject>(this);
+    let old_cells = std::mem::take(&mut host.cells);
+    let old_section_views = std::mem::take(&mut host.section_views);
+    host.loaded = true;
+    for (cell, _, _) in old_cells {
+        () = msg![env; cell removeFromSuperview];
+        release(env, cell);
+    }
+    for view in old_section_views {
+        () = msg![env; view removeFromSuperview];
+        release(env, view);
+    }
+
+    let data_source = env.objc.borrow::<UITableViewHostObject>(this).data_source;
+    let delegate: id = msg![env; this delegate];
+    let bounds: CGRect = msg![env; this bounds];
+    let width = bounds.size.width;
+    let mut y: CGFloat = 0.0;
+
+    let header = env.objc.borrow::<UITableViewHostObject>(this).table_header_view;
+    if header != nil {
+        let frame: CGRect = msg![env; header frame];
+        place_view(env, this, header, rect(0.0, y, width, frame.size.height));
+        y += frame.size.height;
+    }
+
+    let sections: NSInteger = if data_source == nil {
+        0
+    } else if responds(env, data_source, "numberOfSectionsInTableView:") {
+        msg![env; data_source numberOfSectionsInTableView:this]
+    } else {
+        1
+    };
+    let default_row_height = env.objc.borrow::<UITableViewHostObject>(this).row_height;
+    let default_header_height = env.objc.borrow::<UITableViewHostObject>(this).section_header_height;
+
+    for section in 0..sections {
+        let header_view: id = if responds(env, delegate, "tableView:viewForHeaderInSection:") {
+            msg![env; delegate tableView:this viewForHeaderInSection:section]
+        } else {
+            nil
+        };
+        let header_height: CGFloat = if responds(env, delegate, "tableView:heightForHeaderInSection:") {
+            msg![env; delegate tableView:this heightForHeaderInSection:section]
+        } else if header_view != nil {
+            let frame: CGRect = msg![env; header_view frame];
+            frame.size.height
+        } else {
+            default_header_height
+        };
+        if header_view != nil {
+            retain(env, header_view);
+            place_view(env, this, header_view, rect(0.0, y, width, header_height));
+            env.objc
+                .borrow_mut::<UITableViewHostObject>(this)
+                .section_views
+                .push(header_view);
+        }
+        y += header_height;
+
+        let rows: NSInteger = msg![env; data_source tableView:this numberOfRowsInSection:section];
+        for row in 0..rows {
+            let index_path = new_index_path(env, section, row);
+            let height: CGFloat = if responds(env, delegate, "tableView:heightForRowAtIndexPath:") {
+                msg![env; delegate tableView:this heightForRowAtIndexPath:index_path]
+            } else {
+                default_row_height
+            };
+            let cell: id = msg![env; data_source tableView:this cellForRowAtIndexPath:index_path];
+            if cell == nil {
+                log!("Warning: UITableView {:?} got a nil cell for row {} of section {}", this, row, section);
+                continue;
+            }
+            retain(env, cell);
+            place_view(env, this, cell, rect(0.0, y, width, height));
+            env.objc
+                .borrow_mut::<UITableViewHostObject>(this)
+                .cells
+                .push((cell, section, row));
+            let selected = env.objc.borrow::<UITableViewHostObject>(this).selected;
+            set_cell_selected(env, cell, selected == Some((section, row)));
+            // touchHLE doesn't run layout passes on its own.
+            () = msg![env; cell layoutSubviews];
+            y += height;
+        }
+    }
+
+    let footer = env.objc.borrow::<UITableViewHostObject>(this).table_footer_view;
+    if footer != nil {
+        let frame: CGRect = msg![env; footer frame];
+        place_view(env, this, footer, rect(0.0, y, width, frame.size.height));
+        y += frame.size.height;
+    }
+
+    let background = env.objc.borrow::<UITableViewHostObject>(this).background_view;
+    if background != nil {
+        () = msg![env; background setFrame:bounds];
+    }
+
+    () = msg![env; this setContentSize:(CGSize { width, height: y })];
+    () = msg![env; this setNeedsDisplay];
+}
+
+pub const CLASSES: ClassExports = objc_classes! {
+
+(env, this, _cmd);
+
+@implementation UITableView: UIScrollView
+
++ (id)allocWithZone:(NSZonePtr)_zone {
+    let host_object = Box::<UITableViewHostObject>::default();
+    env.objc.alloc_object(this, host_object, &mut env.mem)
+}
+
+- (id)initWithFrame:(CGRect)frame {
+    msg![env; this initWithFrame:frame style:0]
+}
+
+- (id)initWithFrame:(CGRect)frame style:(UITableViewStyle)style {
+    let this: id = msg_super![env; this initWithFrame:frame];
+    env.objc.borrow_mut::<UITableViewHostObject>(this).style = style;
+    () = msg![env; this setClipsToBounds:true];
+    this
+}
+
+- (())dealloc {
+    let host = env.objc.borrow_mut::<UITableViewHostObject>(this);
+    let cells = std::mem::take(&mut host.cells);
+    let section_views = std::mem::take(&mut host.section_views);
+    let others = [host.table_header_view, host.table_footer_view, host.background_view];
+    for (cell, _, _) in cells {
+        release(env, cell);
+    }
+    for view in section_views {
+        release(env, view);
+    }
+    for view in others {
+        release(env, view);
+    }
+    msg_super![env; this dealloc]
+}
+
+- (UITableViewStyle)style {
+    env.objc.borrow::<UITableViewHostObject>(this).style
+}
+
+- (id)dataSource {
+    env.objc.borrow::<UITableViewHostObject>(this).data_source
+}
+- (())setDataSource:(id)data_source {
+    env.objc.borrow_mut::<UITableViewHostObject>(this).data_source = data_source;
+}
+
+- (CGFloat)rowHeight {
+    env.objc.borrow::<UITableViewHostObject>(this).row_height
+}
+- (())setRowHeight:(CGFloat)height {
+    env.objc.borrow_mut::<UITableViewHostObject>(this).row_height = height;
+}
+- (CGFloat)sectionHeaderHeight {
+    env.objc.borrow::<UITableViewHostObject>(this).section_header_height
+}
+- (())setSectionHeaderHeight:(CGFloat)height {
+    env.objc.borrow_mut::<UITableViewHostObject>(this).section_header_height = height;
+}
+- (())setSectionFooterHeight:(CGFloat)_height {
+}
+
+- (id)tableHeaderView {
+    env.objc.borrow::<UITableViewHostObject>(this).table_header_view
+}
+- (())setTableHeaderView:(id)view {
+    retain(env, view);
+    let old = std::mem::replace(&mut env.objc.borrow_mut::<UITableViewHostObject>(this).table_header_view, view);
+    if old != nil && old != view {
+        () = msg![env; old removeFromSuperview];
+    }
+    release(env, old);
+}
+- (id)tableFooterView {
+    env.objc.borrow::<UITableViewHostObject>(this).table_footer_view
+}
+- (())setTableFooterView:(id)view {
+    retain(env, view);
+    let old = std::mem::replace(&mut env.objc.borrow_mut::<UITableViewHostObject>(this).table_footer_view, view);
+    if old != nil && old != view {
+        () = msg![env; old removeFromSuperview];
+    }
+    release(env, old);
+}
+- (id)backgroundView {
+    env.objc.borrow::<UITableViewHostObject>(this).background_view
+}
+- (())setBackgroundView:(id)view {
+    retain(env, view);
+    let old = std::mem::replace(&mut env.objc.borrow_mut::<UITableViewHostObject>(this).background_view, view);
+    if old != nil && old != view {
+        () = msg![env; old removeFromSuperview];
+    }
+    release(env, old);
+    if view != nil {
+        let bounds: CGRect = msg![env; this bounds];
+        () = msg![env; view setFrame:bounds];
+        () = msg![env; this insertSubview:view atIndex:0];
+    }
+}
+
+// Appearance settings that this simplified implementation doesn't draw.
+- (())setSeparatorStyle:(NSInteger)_style {
+}
+- (())setSeparatorColor:(id)_color {
+}
+- (())setAllowsSelection:(bool)_allows {
+}
+
+- (())reloadData {
+    reload_data(env, this);
+}
+- (())_touchHLE_loadIfNeeded {
+    let loaded = env.objc.borrow::<UITableViewHostObject>(this).loaded;
+    if !loaded {
+        reload_data(env, this);
+    }
+}
+- (())layoutSubviews {
+    () = msg![env; this _touchHLE_loadIfNeeded];
+}
+
+// No cell reuse: apps then create a new cell, which is always correct.
+- (id)dequeueReusableCellWithIdentifier:(id)_identifier {
+    nil
+}
+
+- (id)cellForRowAtIndexPath:(id)index_path {
+    let (section, row) = index_path_row_section(env, index_path);
+    cell_for(env, this, section, row)
+}
+- (id)indexPathForCell:(id)cell {
+    let found = env
+        .objc
+        .borrow::<UITableViewHostObject>(this)
+        .cells
+        .iter()
+        .find(|&&(c, _, _)| c == cell)
+        .map(|&(_, s, r)| (s, r));
+    match found {
+        Some((section, row)) => new_index_path(env, section, row),
+        None => nil,
+    }
+}
+- (id)visibleCells {
+    let cells: Vec<id> = env
+        .objc
+        .borrow::<UITableViewHostObject>(this)
+        .cells
+        .iter()
+        .map(|&(cell, _, _)| cell)
+        .collect();
+    let array: id = msg_class![env; NSMutableArray array];
+    for cell in cells {
+        () = msg![env; array addObject:cell];
+    }
+    array
+}
+- (NSInteger)numberOfSections {
+    let data_source = env.objc.borrow::<UITableViewHostObject>(this).data_source;
+    if responds(env, data_source, "numberOfSectionsInTableView:") {
+        msg![env; data_source numberOfSectionsInTableView:this]
+    } else {
+        1
+    }
+}
