+    // OES_draw_texture: draw a screen-aligned textured rectangle, using the
+    // texture's crop rectangle. Emulated with an immediate-mode quad, which
+    // leaves the app's vertex arrays untouched.
+    unsafe fn DrawTexfOES(
+        &mut self,
+        x: GLfloat,
+        y: GLfloat,
+        z: GLfloat,
+        width: GLfloat,
+        height: GLfloat,
+    ) {
+        if width <= 0.0 || height <= 0.0 {
+            return;
+        }
+
+        let mut active_texture: GLint = 0;
+        gl21::GetIntegerv(gl21::ACTIVE_TEXTURE, &mut active_texture);
+        gl21::ActiveTexture(gl21::TEXTURE0);
+
+        let mut texture: GLint = 0;
+        gl21::GetIntegerv(gl21::TEXTURE_BINDING_2D, &mut texture);
+        let (mut tex_width, mut tex_height): (GLint, GLint) = (0, 0);
+        if texture != 0 {
+            gl21::GetTexLevelParameteriv(gl21::TEXTURE_2D, 0, gl21::TEXTURE_WIDTH, &mut tex_width);
+            gl21::GetTexLevelParameteriv(gl21::TEXTURE_2D, 0, gl21::TEXTURE_HEIGHT, &mut tex_height);
+        }
+        let (s0, t0, s1, t1) = if tex_width > 0 && tex_height > 0 {
+            let (tw, th) = (tex_width as GLfloat, tex_height as GLfloat);
+            let crop = self
+                .state
+                .crop_rects
+                .get(&(texture as GLuint))
+                .copied()
+                .unwrap_or([0.0, 0.0, tw, th]);
+            (
+                crop[0] / tw,
+                crop[1] / th,
+                (crop[0] + crop[2]) / tw,
+                (crop[1] + crop[3]) / th,
+            )
+        } else {
+            (0.0, 0.0, 1.0, 1.0)
+        };
